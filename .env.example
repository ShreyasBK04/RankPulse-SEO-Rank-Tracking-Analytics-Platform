# Copy this file to .env or set environment variables in your system.
# Never commit real API keys or database credentials to version control.

# SearchAPI.io API Key (https://www.searchapi.io/)
SEARCH_API_KEY=your_searchapi_key_here

# Database Configuration (for MySQL production profile)
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
